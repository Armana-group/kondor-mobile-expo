{
  "name": "kondor-mobile-expo",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|koilib|ethers|@ethersproject/.*)"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|svg)$": "<rootDir>/__mocks__/fileMock.js"
    }
  },
  "dependencies": {
    "@armana/walletconnect-koinos-sdk-js": "^0.1.4",
    "@ethersproject/shims": "^5.8.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/bottom-tabs": "^7.8.6",
    "@react-navigation/native": "^7.1.20",
    "@react-navigation/native-stack": "^7.6.3",
    "@reown/walletkit": "^1.4.1",
    "@walletconnect/react-native-compat": "^2.23.0",
    "ethers": "^5.8.0",
    "expo": "~54.0.25",
    "expo-application": "^7.0.8",
    "expo-camera": "~17.0.9",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.10",
    "expo-crypto": "~15.0.7",
    "expo-haptics": "~15.0.7",
    "expo-local-authentication": "~17.0.7",
    "expo-random": "^14.0.1",
    "expo-secure-store": "~15.0.7",
    "expo-status-bar": "~3.0.8",
    "fast-text-encoding": "^1.0.6",
    "koilib": "^9.1.0",
    "protobufjs": "^7.5.4",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-qrcode-svg": "^6.3.20",
    "react-native-quick-crypto": "^0.7.17",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-webview": "^13.16.0",
    "text-encoding-polyfill": "^0.6.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "jest-expo": "^54.0.17",
    "typescript": "~5.9.2"
  },
  "private": true
}
