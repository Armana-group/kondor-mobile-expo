{
  "expo": {
    "name": "Kondor Wallet",
    "slug": "kondor-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "kondor",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.armana.kondor",
      "buildNumber": "2",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Kondor uses Face ID to secure your wallet and authorize transactions.",
        "NSCameraUsageDescription": "Kondor uses the camera to scan QR codes for sending tokens.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "2H28Q35Z7Y"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#181818"
      },
      "package": "io.armana.kondor",
      "versionCode": 3,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Kondor needs camera access to scan QR codes for sending tokens."
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/kondor-native-splash.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#181818"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4d410d38-cb5c-4354-b403-0aa29a6b087b"
      }
    }
  }
}
