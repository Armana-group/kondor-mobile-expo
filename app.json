{
  "expo": {
    "name": "Kondor Wallet",
    "slug": "kondor-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "kondor",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#181818"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.armana.kondor",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Kondor uses Face ID to secure your wallet and authorize transactions.",
        "NSCameraUsageDescription": "Kondor uses the camera to scan QR codes for sending tokens.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "2H28Q35Z7Y"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#181818"
      },
      "package": "io.armana.kondor",
      "versionCode": 1,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Kondor needs camera access to scan QR codes for sending tokens."
        }
      ]
    ]
  }
}
